{
  "id": "tw.com.ubot",
  "name": "聯邦銀行／New New Bank",
  "version": 8,
  "versionName": "3.1.4",
  "description": "透過聯邦個人網銀同步存款帳戶；New New Bank 帳戶是否顯示依聯邦個人網銀回應為準",
  "iconUrl": null,
  "credential": {
    "fields": [
      {
        "key": "customerId",
        "label": "身分證字號／統一編號",
        "type": "text",
        "required": true,
        "summary": true
      },
      {
        "key": "userId",
        "label": "使用者代號",
        "type": "text",
        "required": true,
        "summary": true
      },
      {
        "key": "password",
        "label": "網路銀行密碼",
        "type": "password",
        "required": true,
        "summary": false
      }
    ]
  },
  "syncTrigger": {
    "scriptPath": "extension-ubot.min.js"
  }
}
